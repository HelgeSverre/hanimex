{
  "name": "hanimex-virtual-console",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite web --host 127.0.0.1",
    "build": "tsc --noEmit && vite build web",
    "preview": "vite preview web --host 127.0.0.1",
    "test": "node --import tsx --test web/src/*.test.ts",
    "build:chip": "node scripts/build-chip.mjs",
    "test:engines": "node scripts/check-chip-engines.mjs",
    "test:engines:long": "node scripts/check-chip-engines.mjs --long",
    "bench:chip": "node scripts/benchmark-chip.mjs"
  },
  "devDependencies": {
    "@types/three": "^0.187.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "dependencies": {
    "three": "^0.187.0"
  }
}
